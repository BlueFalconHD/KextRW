#include "libkextrw.h"
#include <IOKit/IOKitLib.h>
#include <mach-o/loader.h>
#include <mach/kern_return.h>
#include <mach/mach.h>
#include <stdio.h>
#include <time.h>

#define STATIC_KERNEL_BASE (0xFFFFFE0007004000)

uint64_t gKernelBase = 0, gKernelSlide = 0;

#include "utils.h"

io_connect_t gClient = MACH_PORT_NULL;

void log_prefix() {
  // add time
  time_t t = time(NULL);
  struct tm tm = *localtime(&t);
  printf("[%04d-%02d-%02d %02d:%02d:%02d] ", tm.tm_year + 1900, tm.tm_mon + 1,
         tm.tm_mday, tm.tm_hour, tm.tm_min, tm.tm_sec);
}

static inline io_connect_t kextrw_open(void) {
  io_service_t service = IOServiceGetMatchingService(
      kIOMainPortDefault, IOServiceMatching("KextRW"));
  if (!MACH_PORT_VALID(service)) {
    return MACH_PORT_NULL;
  }

  io_connect_t client = MACH_PORT_NULL;
  kern_return_t ret = IOServiceOpen(service, mach_task_self(), 0, &client);
  IOObjectRelease(service);
  if (ret != KERN_SUCCESS) {
    return MACH_PORT_NULL;
  }
  return client;
}

static inline kern_return_t kextrw_kread(io_connect_t client, uint64_t from,
                                         void *to, uint64_t len) {
  uint64_t scalarInput[2] = {from, len};
  size_t structureOutputSize = len;
  return IOConnectCallMethod(client, 0,                 // selector for kread
                             scalarInput, 2,            // scalar inputs
                             NULL, 0,                   // no struct input
                             NULL, 0,                   // no scalar output
                             to, &structureOutputSize); // struct output
}

static inline kern_return_t kextrw_kwrite(io_connect_t client, void *from,
                                          uint64_t to, uint64_t len) {
  uint64_t scalarInput[2] = {to, len};
  return IOConnectCallMethod(client, 1,      // selector for kwrite
                             scalarInput, 2, // scalar inputs
                             from, len,      // struct input
                             NULL, 0,        // no scalar output
                             NULL, NULL);    // no struct output
}

static inline kern_return_t kextrw_physread(io_connect_t client, uint64_t from,
                                            void *to, uint64_t len,
                                            uint8_t align) {
  uint64_t in[] = {from, (uint64_t)to, len, align};
  return IOConnectCallScalarMethod(client, 2, in, 4, NULL, NULL);
}

static inline kern_return_t kextrw_physwrite(io_connect_t client, void *from,
                                             uint64_t to, uint64_t len,
                                             uint8_t align) {
  uint64_t in[] = {(uint64_t)from, to, len, align};
  return IOConnectCallScalarMethod(client, 3, in, 4, NULL, NULL);
}

static inline kern_return_t kextrw_get_reset_vector(io_connect_t client,
                                                    uint64_t *out) {
  uint32_t outCnt = 1;
  return IOConnectCallScalarMethod(client, 4, NULL, 0, out, &outCnt);
}

static inline kern_return_t kextrw_kvtophys(io_connect_t client, uint64_t va,
                                            uint64_t *out) {
  uint64_t in = va;
  uint32_t outCnt = 1;
  return IOConnectCallScalarMethod(client, 5, &in, 1, out, &outCnt);
}

static inline kern_return_t kextrw_phystokv(io_connect_t client, uint64_t pa,
                                            uint64_t *out) {
  uint64_t in = pa;
  uint32_t outCnt = 1;
  return IOConnectCallScalarMethod(client, 6, &in, 1, out, &outCnt);
}

static inline kern_return_t kextrw_kcall(io_connect_t client, uint64_t fn,
                                         uint64_t *args, uint32_t argsCnt,
                                         uint64_t *out) {
  uint64_t argsBuf[11] = {0};
  argsBuf[0] = fn;
  for (uint32_t i = 0; i < argsCnt; i++) {
    if (args[i])
      argsBuf[i + 1] = args[i] ? args[i] : 0;
  }
  uint32_t outCnt = 1;
  uint64_t rv = 0;
  IOReturn ret =
      IOConnectCallScalarMethod(client, 7, argsBuf, 11, &rv, &outCnt);
  if (out)
    *out = rv;
  return ret;
}

static inline kern_return_t kextrw_kalloc(io_connect_t client, uint64_t size,
                                          uint64_t *out) {
  uint64_t in = size;
  uint32_t outCnt = 1;
  return IOConnectCallScalarMethod(client, 8, &in, 1, out, &outCnt);
}

static inline kern_return_t kextrw_kfree(io_connect_t client, uint64_t addr,
                                         uint64_t size) {
  uint64_t in[] = {addr, size};
  return IOConnectCallScalarMethod(client, 9, in, 2, NULL, NULL);
}

void kextrw_close(io_connect_t client) { IOServiceClose(client); }

int kextrw_init(void) {
  gClient = kextrw_open();
  return MACH_PORT_VALID(gClient) ? 0 : -1;
}

void kextrw_deinit(void) {
  if (MACH_PORT_VALID(gClient)) {
    kextrw_close(gClient);
  }
}

/* Virtual read/write */

uint8_t kread8(uint64_t addr) {
  uint8_t val = 0;
  kextrw_kread(gClient, addr, &val, sizeof(val));
  return val;
}

uint16_t kread16(uint64_t addr) {
  uint16_t val = 0;
  kextrw_kread(gClient, addr, &val, sizeof(val));
  return val;
}

uint32_t kread32(uint64_t addr) {
  uint32_t val = 0;
  kextrw_kread(gClient, addr, &val, sizeof(val));
  return val;
}

uint64_t kread64(uint64_t addr) {
  uint64_t val = 0;
  kextrw_kread(gClient, addr, &val, sizeof(val));
  return val;
}

int kreadbuf(uint64_t addr, void *buf, size_t len) {
  return kextrw_kread(gClient, addr, buf, len);
}

void kwrite8(uint64_t addr, uint8_t val) {
  kextrw_kwrite(gClient, &val, addr, sizeof(val));
}

void kwrite16(uint64_t addr, uint16_t val) {
  kextrw_kwrite(gClient, &val, addr, sizeof(val));
}

void kwrite32(uint64_t addr, uint32_t val) {
  kextrw_kwrite(gClient, &val, addr, sizeof(val));
}

void kwrite64(uint64_t addr, uint64_t val) {
  kextrw_kwrite(gClient, &val, addr, sizeof(val));
}

int kwritebuf(uint64_t addr, void *buf, size_t len) {
  return kextrw_kwrite(gClient, buf, addr, len);
}

static uint64_t xpaci(uint64_t pointer) {
  asm("xpaci %[value]\n" : [value] "+r"(pointer));
  return pointer;
}

uint64_t kreadptr(uint64_t addr) { return xpaci(kread64(addr)); }

// macOS 15.3 KDK, ipc_entry_lookup
uint64_t kreadptr_smr(uint64_t addr) {
  uint64_t ptr = kreadptr(addr);
  if ((ptr & 0x400000000000LL) != 0) {
    return ptr & 0xFFFFFFFFFFFFFFE0LL;
  }
  return ptr;
}

/* Physical read/write */

uint8_t physread8(uint64_t addr) {
  uint8_t val = 0;
  kextrw_physread(gClient, addr, &val, sizeof(val), 1);
  return val;
}

uint16_t physread16(uint64_t addr) {
  uint16_t val = 0;
  kextrw_physread(gClient, addr, &val, sizeof(val), 2);
  return val;
}

uint32_t physread32(uint64_t addr) {
  uint32_t val = 0;
  kextrw_physread(gClient, addr, &val, sizeof(val), 4);
  return val;
}

uint64_t physread64(uint64_t addr) {
  uint64_t val = 0;
  kextrw_physread(gClient, addr, &val, sizeof(val), 8);
  return val;
}

int physreadbuf(uint64_t addr, void *buf, size_t len) {
  return kextrw_physread(gClient, addr, buf, len, 1);
}

void physwrite8(uint64_t addr, uint8_t val) {
  kextrw_physwrite(gClient, &val, addr, sizeof(val), 1);
}

void physwrite16(uint64_t addr, uint16_t val) {
  kextrw_physwrite(gClient, &val, addr, sizeof(val), 2);
}

void physwrite32(uint64_t addr, uint32_t val) {
  kextrw_physwrite(gClient, &val, addr, sizeof(val), 4);
}

void physwrite64(uint64_t addr, uint64_t val) {
  kextrw_physwrite(gClient, &val, addr, sizeof(val), 8);
}

int physwritebuf(uint64_t addr, void *buf, size_t len) {
  return kextrw_physwrite(gClient, buf, addr, len, 1);
}

/* Kernel call */

uint64_t kcall(uint64_t fn, uint64_t *args, uint32_t argsCnt) {
  uint64_t rv = 0;
  if (argsCnt > 10)
    return KERN_INVALID_ARGUMENT;
  kern_return_t kr = kextrw_kcall(gClient, fn, args, argsCnt, &rv);
  if (kr != KERN_SUCCESS)
    printf("WARNING: kcall failed with error %d\n", kr);
  return rv;
}

/* Translation */

uint64_t kvtophys(uint64_t va) {
  uint64_t pa = 0;
  kextrw_kvtophys(gClient, va, &pa);
  return pa;
}

uint64_t phystokv(uint64_t pa) {
  uint64_t va = 0;
  kextrw_phystokv(gClient, pa, &va);
  return va;
}

/* Allocations */

uint64_t kalloc(uint64_t size) {
  uint64_t addr = 0;
  kextrw_kalloc(gClient, size, &addr);
  return addr;
}

void kfree(uint64_t addr, uint64_t size) { kextrw_kfree(gClient, addr, size); }

/* Utilities */

uint64_t get_kernel_base() {
  const bool debug = true; // Set to false to disable debug output
  // const size_t CHUNK_SIZE = 0x10000000; // 256MB chunk size
  const size_t CHUNK_SIZE = 0x100; // 256byte chunk size

  // every large region print statement (every 1,048,575 iterations of
  // 0x10000000 MB read)
  const uint64_t MAX_FAILED_RANGE_SIZE =
      CHUNK_SIZE * 3145727; // Threshold for reporting failed ranges (every
                            // 1,048,575 iterations)

  if (debug)
    printf("[+] Searching for kernel base...\n");

  uint64_t resetVector = 0;
  kern_return_t kr = kextrw_get_reset_vector(gClient, &resetVector);

  if (kr != KERN_SUCCESS || !resetVector) {
    if (debug)
      printf("[-] Failed to get reset vector\n");
    return 0;
  }

  if (debug)
    printf("[+] Reset vector at 0x%llx\n", resetVector);

  // Align to page boundary
  uint64_t startAddress = resetVector & ~(uint64_t)PAGE_MASK;
  uint64_t kernelBase = 0;
  uint64_t iterations = 0;

  // Allocate buffer for chunk reading
  unsigned char *buffer = malloc(CHUNK_SIZE);
  if (!buffer) {
    if (debug)
      printf("[-] Failed to allocate memory for chunk buffer\n");
    return 0;
  }

  // Variables to track failed read ranges
  uint64_t failedRangeStart = 0;
  uint64_t failedRangeEnd = 0;

  int lastReason = 0;

  while (startAddress >
         0xffff00000000000) { // Don't go below a reasonable address
    if (debug && (iterations & 0xFFFFF) == 0) { // Report every 65536 iterations

      printf("[*] Read a large chunk of memory at 0x%llx (%llu iterations). "
             "0x%llx MB remaining\n",
             startAddress, iterations, (startAddress / 0x100000));
    }

    // Read a large chunk of memory
    uint64_t readSize = CHUNK_SIZE;
    bool readFailed = false;

    if (kreadbuf(startAddress - CHUNK_SIZE, buffer, readSize) != KERN_SUCCESS) {
      // Try a smaller read if this fails
      readSize = PAGE_SIZE * 16;
      int err = kreadbuf(startAddress - readSize, buffer, readSize);
      if (err != KERN_SUCCESS) {
        // Mark this as a failed read
        readFailed = true;
        lastReason = err;

        // Update failed read range
        if (failedRangeStart == 0) {
          // Starting a new failed range
          failedRangeEnd = startAddress;
          failedRangeStart = startAddress - readSize;
        } else {
          // Extend the failed range
          failedRangeStart = startAddress - readSize;
        }

        // Check if failed range exceeds threshold
        if ((failedRangeEnd - failedRangeStart) >= MAX_FAILED_RANGE_SIZE) {
          if (debug) {
            printf("[-] Failed to read memory range: 0x%llx - 0x%llx\n",
                   failedRangeStart, failedRangeEnd);
            printf("[-] Last error: %s (0x%llx)\n", get_error_name(lastReason),
                   lastReason);
          }
          // Reset failed range tracking
          failedRangeStart = 0;
          failedRangeEnd = 0;
        }

        // Move to next chunk if read fails
        startAddress -= readSize;
        iterations++;
        continue;
      }
    } else {
      // If we had a failed range and now read succeeds, report the failed range
      if (failedRangeStart != 0) {
        if (debug) {
          printf("[-] Failed to read memory range: 0x%llx - 0x%llx\n",
                 failedRangeStart, failedRangeEnd);
          printf("[-] Last error: %s (0x%llx)\n", get_error_name(lastReason),
                 lastReason);
        }
        // Reset failed range tracking
        failedRangeStart = 0;
        failedRangeEnd = 0;
      }
    }

    // Scan chunk for Mach-O header from end to beginning
    for (int64_t offset = readSize - 4; offset >= 0; offset -= 4) {
      uint32_t *magic = (uint32_t *)(buffer + offset);

      if (*magic == MH_MAGIC_64 || *magic == MH_CIGAM_64) {
        // Potential Mach-O header found
        uint64_t headerAddr = startAddress - readSize + offset;

        // Read file type directly from kernel memory to confirm
        uint32_t fileType = kread32(headerAddr + 0xC);

        if (debug) {
          log_prefix();
          printf(
              "[*] Found Mach-O header at 0x%llx (magic: 0x%x, type: 0x%x)\n",
              headerAddr, *magic, fileType);
        }

        if (fileType == MH_EXECUTE) {
          // Found the kernel!
          kernelBase = headerAddr;
          if (debug)
            printf("[+] Kernel base found!\n");
          goto cleanup;
        }
      }
    }

    // Move to next chunk
    startAddress -= readSize;
    iterations++;
  }

cleanup:

  // If we exit the loop and have a failed range, report it
  if (failedRangeStart != 0) {
    if (debug) {
      printf("[-] Failed to read memory range: 0x%llx - 0x%llx\n",
             failedRangeStart, failedRangeEnd);
    }
  }

  free(buffer);

  if (kernelBase) {
    gKernelBase = kernelBase;
    gKernelSlide = kernelBase - STATIC_KERNEL_BASE;

    printf("gKernelBase: 0x%llx\n", gKernelBase);
    printf("staticKernelBase: 0x%llx\n", STATIC_KERNEL_BASE);
    printf("gKernelSlide: 0x%llx\n", gKernelSlide);

    if (debug) {
      printf("[+] Kernel base: 0x%llx\n", kernelBase);
      printf("[+] Kernel slide: 0x%llx\n", gKernelSlide);
    }
  } else if (debug) {
    printf("[-] Failed to find kernel base\n");
  }

  return kernelBase;
}
